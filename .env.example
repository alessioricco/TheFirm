# Copy to .env (git-ignored) and fill in. Never commit real values.
# v1 is paper only: no trading API keys are needed. Crypto market data is public.

# Hosts are configuration: any machine can run any service (models, bus,
# trading stack). Nothing in the code assumes a particular host or GPU.

# Market-data store (git-ignored; this repo is public, data never goes in git)
FIRM_DATA_ROOT=./data
# Verifier state: trial registry, OOS openings, reports (git-ignored, private)
FIRM_STATE_ROOT=./state

# Local model server
OLLAMA_HOST=http://models.local:11434

# Message bus
NATS_URL=nats://bus.local:4222

# US shares data (milestone 6)
EODHD_API_KEY=

# Notifications to the owner (milestone 4)
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# Frontier model providers (used only through Certo's ladder and the egress
# gate). Keys only: which model, budgets and egress policy live in
# config/models.yaml (cloud budget defaults to zero there).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
