# Settings for scripts/certo-mcp. Copy to private/certo-mcp.env (git-ignored)
# and fill in. Only CERTO_LLM_BASE_URL is required; the rest have defaults.

# The DGX's Ollama (the same host as OLLAMA_HOST in .env)
CERTO_LLM_BASE_URL=http://<dgx-host>:11434

# Optional
# CERTO_LLM_MODEL=ollama/qwen3.8:27b        # config/models.yaml, role research
# CERTO_LLM_TIMEOUT_SECONDS=1200            # one model call
# CERTO_MAX_TASK_SECONDS=3600               # one task
# CERTO_BIN=/path/to/certo                  # default: certo on the PATH (0.2.4 or later)
# FIRM_CERTO_WORKSPACE=/path/to/workspace   # default: <data root>/research/certo
