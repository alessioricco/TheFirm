#!/bin/sh
# Pre-commit guard for a PUBLIC repo. Enable once per clone:
#   git config core.hooksPath .githooks
set -e
python3 scripts/check_repo.py --staged
py=$(git diff --cached --name-only --diff-filter=ACMR -- '*.py')
if [ -n "$py" ]; then
    uv run --quiet ruff check --quiet $py
    uv run --quiet ruff format --check --quiet $py
fi
