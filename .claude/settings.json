{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.envrc)",
      "Read(./secrets/**)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.envrc)",
      "Edit(./secrets/**)",
      "Bash(cat .env*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ],
    "ask": [
      "Edit(./config/risk/**)",
      "Edit(./config/jurisdictions/**)",
      "Edit(./config/verify/**)",
      "Edit(./.github/workflows/**)",
      "Edit(./scripts/check_repo.py)",
      "Edit(./.githooks/**)",
      "Bash(git push:*)"
    ]
  }
}
